# Server
PORT=4000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/petmorph

# JWT (optional auth — local mode works without any token)
JWT_SECRET=change-me-to-a-long-random-string

# AI provider: "openai" | "mock"
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# OpenAI-compatible base URL (change provider later without code changes)
AI_BASE_URL=https://api.openai.com/v1

# TTS provider: "cloud" | "mock"
TTS_PROVIDER=mock
TTS_API_KEY=
TTS_BASE_URL=

# Image processing provider: "local" | "removebg"
IMAGE_PROVIDER=local
IMAGE_API_KEY=

# Storage provider: "local" | "s3"
STORAGE_PROVIDER=local
STORAGE_URL=./data/storage
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Upload limits
MAX_UPLOAD_MB=10
